# Copy the values you need into the build environment (Render dashboard, or PowerShell for the desktop build).
# Everything here is public configuration. NEVER put API keys or passwords in a VITE_ variable.

# Hosted API (Render). Must end with /api/v1
VITE_API_URL=https://nexo-api.onrender.com/api/v1

# Start in server mode (real accounts and cloud data) instead of the local mock.
VITE_DEFAULT_MODE=server

# Supabase project (Settings > API). The anon key is public by design.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Where the landing's "Descargar para Windows" button points (optional).
# VITE_RELEASES_URL=https://github.com/KevinTimaran/Nexo_Frontend/releases/latest
