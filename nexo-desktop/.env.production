# Public production configuration for the web (Vercel) and desktop (Tauri) builds.
# Everything here is PUBLIC by design and ends up in the browser bundle. NEVER put API keys,
# service-role keys or passwords in this file.
# A variable with the same name set in Vercel (Settings > Environment Variables) wins over this file.

# Hosted API (Render). Must end with /api/v1
VITE_API_URL=https://nexo-api-lxbs.onrender.com/api/v1

# Start in server mode (real accounts and cloud data) instead of the local mock.
VITE_DEFAULT_MODE=server

# Supabase project. The publishable key is meant to be public; access is enforced by RLS and the API.
VITE_SUPABASE_URL=https://akagaivgsracmdebasmb.supabase.co
